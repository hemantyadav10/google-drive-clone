# Application
APP_NAME=DriveClone
LOG_LEVEL=debug
PORT=8080
CLIENT_URL=http://localhost:5173
RATE_LIMIT_ENABLED_IN_DEV=false

# Database (PostgreSQL)
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<local_dev_password>
POSTGRES_DB=driveclone
DB_URL=postgres://driveclone:<local_dev_password>@localhost:5432/driveclone

# Redis
REDIS_URL=redis://localhost:6379

# OAuth — Google
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Security — Cloudflare Turnstile
TURNSTILE_SECRET_KEY=<cloudflare_turnstile_secret_key>
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA #Always passes validation
# TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA #Always fails validation

# Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
MAILPIT_HOST=localhost
MAILPIT_PORT=1025

# Object Storage — S3 Compatible
S3_ACCESS_KEY_ID=<s3_access_key_id>
S3_SECRET_ACCESS_KEY=<s3_secret_access_key>
S3_BUCKET_NAME=<s3_bucket_name>
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
